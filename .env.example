# API
DATABASE_URL=sqlite:///./assetlens.db
DEMO_TOKEN=assetlens-demo-token
WEB_ORIGIN=http://localhost:3000
TASK_MODE=local
REDIS_URL=redis://localhost:6379/0

# Optional live copilot. Without a key, AssetLens uses its deterministic grounded mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
COPILOT_PROVIDER=auto
OTEL_SERVICE_NAME=assetlens-api
OTEL_EXPORTER_OTLP_ENDPOINT=

# Web
NEXT_PUBLIC_API_BASE=/api
